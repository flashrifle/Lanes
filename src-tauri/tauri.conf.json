{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanes",
  "version": "0.1.0",
  "identifier": "io.github.flashrifle.lanes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lanes",
        "width": 1400,
        "height": 900,
        "minWidth": 900
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../NOTICE": "NOTICE",
      "../licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "../src/assets/fonts/LICENSES.txt": "licenses/fonts-OFL.txt"
    },
    "copyright": "Copyright © 2026 J-Lab",
    "publisher": "J-Lab",
    "category": "DeveloperTool",
    "macOS": {
      "signingIdentity": "Developer ID Application: jaemin lee (ZHQJ79W867)",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_UPDATER_PUBKEY",
      "endpoints": [
        "https://github.com/flashrifle/Lanes/releases/latest/download/latest.json"
      ]
    }
  }
}
