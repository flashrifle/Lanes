{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanes",
  "version": "0.1.0",
  "identifier": "io.github.flashrifle.lanes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lanes",
        "width": 1400,
        "height": 900,
        "minWidth": 900
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "devCsp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../NOTICE": "NOTICE",
      "../licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "../src/assets/fonts/LICENSES.txt": "licenses/fonts-OFL.txt"
    },
    "copyright": "Copyright © 2026 J-Lab",
    "publisher": "J-Lab",
    "category": "DeveloperTool",
    "macOS": {
      "signingIdentity": "Developer ID Application: jaemin lee (ZHQJ79W867)",
      "hardenedRuntime": true,
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIyNTE1NjIzREFGMTdERkQKUldUOWZmSGFJMVpSc2pnMk5mbWFwd1R3cXk4OHBpRFBHV2ZXZDZYWStxejNYSjVkLzVDMFZNdzMK",
      "endpoints": [
        "https://github.com/flashrifle/Lanes/releases/latest/download/latest.json"
      ]
    }
  }
}
